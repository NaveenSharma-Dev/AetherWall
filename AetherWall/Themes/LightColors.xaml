<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E9EDF4"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="DisplayCanvasBackgroundBrush" Color="#F0F2F6"/>
    <SolidColorBrush x:Key="DisplayTileBackgroundBrush" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="DisplayTileBorderBrush" Color="#8B95A5"/>
    <SolidColorBrush x:Key="DisplaySelectedBrush" Color="#087FD7"/>
    <SolidColorBrush x:Key="DisplaySelectedBorderBrush" Color="#3B9DE5"/>
    <SolidColorBrush x:Key="DisplayTileHoverBorderBrush" Color="#344054"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D6DCE5"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202632"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#586273"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#748094"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6847E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5738D6"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#23834D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6500"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C34352"/>

</ResourceDictionary>
