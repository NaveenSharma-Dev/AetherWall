<UserControl x:Class="AetherWall.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Your saved wallpapers"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding FavoriteWallpapers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280"
                                    Height="250"
                                    Margin="0,0,16,16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            CornerRadius="14,14,0,0"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailPath}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,8,7">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black"
                                                                      BlurRadius="3"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.9"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="14,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>

                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Resolution}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="  •  "
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding Format}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom">
                                            <Button Content="Apply"
                                                    Command="{Binding DataContext.ApplyWallpaperCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="11,5"/>

                                            <Button Content="♥"
                                                    Margin="6,0,0,0"
                                                    Padding="10,6"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FavoriteButtonStyle}">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="⋮"
                                                    Margin="6,0,0,0"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource FavoriteButtonStyle}"
                                                    ToolTip="More options"
                                                    Click="OpenWallpaperMenu_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkOverflowMenuStyle}"
                                                                 DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Rename"
                                                                  Command="{Binding Tag.RenameWallpaperCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                        <MenuItem Header="Open file location"
                                                                  Command="{Binding Tag.OpenFileLocationCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                        <MenuItem Header="Delete"
                                                                  Foreground="{DynamicResource DangerBrush}"
                                                                  Command="{Binding Tag.DeleteWallpaperCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No favorite wallpapers yet. Use the heart in Library to save one."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FavoriteWallpapers.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
