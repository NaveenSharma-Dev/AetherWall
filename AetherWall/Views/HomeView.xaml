<UserControl x:Class="AetherWall.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,0"
                Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="320"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Displays"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select a monitor to view its wallpaper and controls."
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Identify"
                                Command="{Binding IdentifyDisplaysCommand}"
                                Style="{StaticResource FavoriteButtonStyle}"
                                Padding="11,6"
                                Margin="0,0,8,0"/>
                        <Button Content="Detect"
                                Command="{Binding DetectDisplaysCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="11,6"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource DisplayCanvasBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Viewbox Stretch="Uniform"
                             Margin="8">
                        <ItemsControl ItemsSource="{Binding Displays}"
                                      Width="760"
                                      Height="240">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="760"
                                            Height="240"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left"
                                            Value="{Binding LayoutLeft}"/>
                                    <Setter Property="Canvas.Top"
                                            Value="{Binding LayoutTop}"/>
                                    <Setter Property="Width"
                                            Value="{Binding TileWidth}"/>
                                    <Setter Property="Height"
                                            Value="{Binding TileHeight}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Title}"
                                            Padding="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource DisplayTileBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DisplayTileBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DisplaySelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DisplaySelectedBorderBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DisplayTileHoverBorderBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                                    <Grid ClipToBounds="True">
                                                        <Image Source="{Binding SelectedWallpaper.ThumbnailPath}"
                                                               Stretch="UniformToFill"/>
                                                        <Rectangle Fill="#26000000"/>
                                                        <Border HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="8"
                                                                Padding="7,3"
                                                                Background="#D9111419"
                                                                CornerRadius="5">
                                                            <TextBlock Text="{Binding Number}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                </Grid>
                
                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDisplay.Title, TargetNullValue='No display selected'}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedDisplay.Resolution}"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right"
                                    Width="220">
                            <TextBlock Text="Display mode"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SelectedDisplay.DisplayModes}"
                                      SelectedItem="{Binding SelectedDisplay.SelectedDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      MinHeight="38"
                                      ToolTip="Choose Fit, Fill, or Stretch for this screen."/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="200"
                                Height="112"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SelectedDisplay.SelectedWallpaper.ThumbnailPath}"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="18,0,20,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDisplay.AssignedWallpaperName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedDisplay.WallpaperMetadata}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Open Library"
                                    Command="{Binding ShowLibraryCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="13,8"
                                    Margin="0,0,8,0"/>

                            <Button Command="{Binding PreviousWallpaperCommand}"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTip="Previous wallpaper on this display"
                                    AutomationProperties.Name="Previous wallpaper on this display">
                                <TextBlock Text="&#xE892;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>

                            <Button Command="{Binding SelectedDisplay.TogglePlaybackCommand}"
                                    IsEnabled="{Binding SelectedDisplay.CanTogglePlayback}"
                                    ToolTip="{Binding SelectedDisplay.PauseResumeLabel}"
                                    AutomationProperties.Name="{Binding SelectedDisplay.PauseResumeLabel}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource TransportButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDisplay.IsWallpaperPlaying}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding SelectedDisplay.PlaybackToggleIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>

                            <Button Command="{Binding NextWallpaperCommand}"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTip="Next wallpaper on this display"
                                    AutomationProperties.Name="Next wallpaper on this display">
                                <TextBlock Text="&#xE893;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>

                            <Button Command="{Binding ToggleAudioCommand}"
                                    Style="{StaticResource TransportButtonStyle}"
                                    ToolTip="Toggle wallpaper audio"
                                    AutomationProperties.Name="Toggle wallpaper audio">
                                <TextBlock Text="{Binding AudioToggleIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Changes are saved automatically"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>

            </Grid>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="2"
                     Margin="0,18,0,0">
            <Border Margin="0,0,10,0"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="LIBRARY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding WallpaperCount}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,4,0,6"/>
                    <Button Content="Browse wallpapers"
                            Command="{Binding ShowLibraryCommand}"
                            Style="{StaticResource FavoriteButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Margin="10,0,0,0"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="FAVORITES"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding FavoriteCount}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,4,0,6"/>
                    <Button Content="View favorites"
                            Command="{Binding ShowFavoritesCommand}"
                            Style="{StaticResource FavoriteButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

        </UniformGrid>
    </Grid>
    </ScrollViewer>

</UserControl>
