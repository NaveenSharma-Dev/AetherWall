<UserControl x:Class="AetherWall.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="4">

			<TextBlock Text="Configure wallpaper audio and playback behavior."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,24"/>

			<Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">
				<StackPanel>
					<TextBlock Text="Appearance"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
					<TextBlock Text="Choose the look of AetherWall. Your choice is saved automatically."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
					<StackPanel Orientation="Horizontal">
						<Button Content="{Binding ThemeButtonContent}"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,8"/>
						<TextBlock Text="{Binding ThemeDescription}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">

				<StackPanel>
					<TextBlock Text="Wallpaper audio"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<TextBlock Text="Audio is muted by default. Enable it and adjust the volume for your wallpapers."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

					<CheckBox Content="Enable wallpaper audio"
                              IsChecked="{Binding AudioEnabled, Mode=TwoWay}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="60"/>
						</Grid.ColumnDefinitions>

						<Slider Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="10"
                                IsMoveToPointEnabled="True"
                                IsEnabled="{Binding AudioEnabled}"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0"/>

						<TextBlock Grid.Column="1"
                                   Text="{Binding Volume, StringFormat={}{0}%}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
					</Grid>
				</StackPanel>
			</Border>

			<Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">

				<StackPanel>
					<TextBlock Text="Playback"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<TextBlock Text="Choose when animated wallpapers should pause automatically."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

					<CheckBox Content="Pause when a fullscreen application is detected"
                              IsChecked="{Binding PauseOnFullscreen, Mode=TwoWay}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16"/>

					<CheckBox Content="Pause when running on battery power"
                              IsChecked="{Binding PauseOnBattery, Mode=TwoWay}"
                              Foreground="{DynamicResource PrimaryTextBrush}"/>
				</StackPanel>
			</Border>

			<Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">

				<StackPanel>
					<TextBlock Text="Startup"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<TextBlock Text="Choose whether AetherWall opens automatically after you sign in to Windows."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

					<CheckBox Content="Open AetherWall when Windows starts"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,10"/>

					<TextBlock Text="{Binding StartupStatus}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">

				<StackPanel>
					<TextBlock Text="About AetherWall"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<TextBlock Text="AetherWall 2.0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

					<TextBlock Text="Made by Naveen"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
				</StackPanel>
			</Border>

			<TextBlock Text="Changes are saved automatically."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"/>

		</StackPanel>
	</ScrollViewer>
</UserControl>
