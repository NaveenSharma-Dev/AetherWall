<Window x:Class="AetherWall.Views.MonitorSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose displays"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Apply wallpaper"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1"
                    Margin="0,6,0,14">
            <TextBlock Text="Choose the display or displays for this wallpaper."
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="{Binding WallpaperName}"
                       Margin="0,5,0,0"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MonitorChoices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalContentAlignment="Center">
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Resolution}"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <Button x:Name="SelectAllButton"
                    Content="Select all"
                    Click="SelectAll_Click"
                    Style="{StaticResource FavoriteButtonStyle}"
                    HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Style="{StaticResource FavoriteButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="14,7"/>
                <Button Content="Apply"
                        Click="Apply_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="18,7"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
