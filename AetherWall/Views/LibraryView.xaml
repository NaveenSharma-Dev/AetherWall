<UserControl x:Class="AetherWall.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AetherWall.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="5,5"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         FontSize="14"
                         Padding="4,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Search wallpapers by name"/>

                <ComboBox Grid.Column="2"
                          Width="220"
                          Height="36"
                          Margin="8,0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ToolTip="Sort wallpapers"
                          SelectedValue="{Binding SortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="Name (A–Z)"
                                  Tag="{x:Static vm:WallpaperSortOrder.NameAscending}"/>
                    <ComboBoxItem Content="Name (Z–A)"
                                  Tag="{x:Static vm:WallpaperSortOrder.NameDescending}"/>
                    <ComboBoxItem Content="Duration (Shortest first)"
                                  Tag="{x:Static vm:WallpaperSortOrder.DurationAscending}"/>
                    <ComboBoxItem Content="Duration (Longest first)"
                                  Tag="{x:Static vm:WallpaperSortOrder.DurationDescending}"/>
                    <ComboBoxItem Content="Resolution (Lowest first)"
                                  Tag="{x:Static vm:WallpaperSortOrder.ResolutionAscending}"/>
                    <ComboBoxItem Content="Resolution (Highest first)"
                                  Tag="{x:Static vm:WallpaperSortOrder.ResolutionDescending}"/>
                </ComboBox>

                <Button Grid.Column="3"
                        Content="↻"
                        Command="{Binding RefreshLibraryCommand}"
                        Style="{StaticResource FavoriteButtonStyle}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        FontSize="18"
                        Margin="0,0,4,0"
                        ToolTip="Refresh library"/>

                <Button Content="Clear"
                        Grid.Column="4"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource FavoriteButtonStyle}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10,6"
                        Width="90"
                        Height="36"
                        FontSize="13"
                        ToolTip="Clear search"/>
            </Grid>
        </Border>

        <!-- Wallpaper library -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <ItemsControl ItemsSource="{Binding FilteredWallpapers}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Width="280"
                                    Height="250"
                                    Margin="0,0,16,16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0"
                                            CornerRadius="14,14,0,0"
                                            ClipToBounds="True">

                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailPath}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>

                                        <Grid>
                                            <TextBlock Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,8,7">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black"
                                                                      BlurRadius="3"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.9"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Wallpaper information -->
                                    <Grid Grid.Row="1"
                                          Margin="14,12">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>

                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    Margin="0,6,0,0">

                                            <TextBlock Text="{Binding Resolution}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                                            <TextBlock Text="  •  "
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>

                                            <TextBlock Text="{Binding Format}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom">

                                            <Button Content="Apply"
                                                    Command="{Binding DataContext.ApplyWallpaperCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="8,5"
                                                    Width="64"
                                                    Height="32"
                                                    FontSize="13"/>

                                            <Button Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,6">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FavoriteButtonStyle}">
                                                        <Setter Property="Content" Value="♡"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Content" Value="♥"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="⋮"
                                                    Margin="6,0,0,0"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource FavoriteButtonStyle}"
                                                    ToolTip="More options"
                                                    Click="OpenWallpaperMenu_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkOverflowMenuStyle}"
                                                                 DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Rename"
                                                                  Command="{Binding Tag.RenameWallpaperCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                        <MenuItem Header="Open file location"
                                                                  Command="{Binding Tag.OpenFileLocationCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                        <MenuItem Header="Delete"
                                                                  Foreground="{DynamicResource DangerBrush}"
                                                                  Command="{Binding Tag.DeleteWallpaperCommand}"
                                                                  CommandParameter="{Binding DataContext}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty search results -->
                <TextBlock Text="No wallpapers match your search."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
